{
  "name": "atupa-backend",
  "version": "1.0.0",
  "description": "Backend microservices for Atupa Yoruba learning app",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "concurrently \"tsc -w\" \"nodemon dist/index.js\"",
    "dev:services": "concurrently \"npm run dev:auth\" \"npm run dev:user\" \"npm run dev:quiz\" \"npm run dev:progress\" \"npm run dev:leaderboard\" \"npm run dev:subscription\" \"npm run dev:notification\" \"npm run dev:content\"",
    "dev:auth": "nodemon dist/services/auth/server.js",
    "dev:user": "nodemon dist/services/user/server.js",
    "dev:quiz": "nodemon dist/services/quiz/server.js",
    "dev:progress": "nodemon dist/services/progress/server.js",
    "dev:leaderboard": "nodemon dist/services/leaderboard/server.js",
    "dev:subscription": "nodemon dist/services/subscription/server.js",
    "dev:notification": "nodemon dist/services/notification/server.js",
    "dev:content": "nodemon dist/services/content/server.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "yoruba",
    "learning",
    "quiz",
    "microservices",
    "api"
  ],
  "author": "Oyekanmi Owolabi",
  "license": "ISC",
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.2.1",
    "@types/node-fetch": "^2.6.13",
    "@types/nodemailer": "^6.4.17",
    "bcryptjs": "^3.0.2",
    "concurrently": "^9.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.17.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.5",
    "nodemon": "^3.1.10",
    "stripe": "^18.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
