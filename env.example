# Environment Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/atupa
MONGODB_TEST_URI=mongodb://localhost:27017/atupa_test

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=atupapp@gmail.com
SMTP_PASS=Manager2025!@

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Firebase Configuration (for authentication)
FIREBASE_PROJECT_ID=yorubapp-2025
FIREBASE_CLIENT_EMAIL=firebase-client-email
FIREBASE_PRIVATE_KEY=firebase-private-key

# Service Ports
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
QUIZ_SERVICE_PORT=3003
PROGRESS_SERVICE_PORT=3004
LEADERBOARD_SERVICE_PORT=3005
SUBSCRIPTION_SERVICE_PORT=3006
NOTIFICATION_SERVICE_PORT=3007
CONTENT_SERVICE_PORT=3008

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379

# API Gateway
API_GATEWAY_PORT=3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
